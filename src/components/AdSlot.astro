---
interface Props {
  slot: string;
  label?: string;
}

const { slot, label = 'Advertisement' } = Astro.props;
const AD_CLIENT = 'ca-pub-7164999486301748';
---

<section class="wrap ad-slot-wrap" aria-label={label}>
  <p class="ad-label">Advertisement</p>
  <ins class="adsbygoogle ad-slot"
       style="display:block"
       data-ad-client={AD_CLIENT}
       data-ad-slot={slot}
       data-ad-format="auto"
       data-full-width-responsive="true"></ins>
</section>
