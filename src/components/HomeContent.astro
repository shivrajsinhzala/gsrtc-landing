<section id="screens" class="wrap section">
  <h2><Fragment set:html={t.screensH} /></h2>
  <p class="sub"><Fragment set:html={t.screensSub} /></p>

  <div class="screens">
    <!-- Screen 1: Live Track -->
    <figure class="shot reveal">
      <picture>
        <source srcset="/screens/track-dark.webp" media="(prefers-color-scheme: dark)">
        <img class="device" src="/screens/track-light.webp" alt="Live bus tracking screen showing Gujarat ST bus on map with ETA and speed" width="390" height="844" decoding="async" loading="lazy">
      </picture>
      <figcaption><Fragment set:html={t.shot1} /></figcaption>
    </figure>

    <!-- Screen 2: Timetable Departures -->
    <figure class="shot reveal">
      <picture>
        <source srcset="/screens/routes-dark.webp" media="(prefers-color-scheme: dark)">
        <img class="device" src="/screens/routes-light.webp" alt="Route timetable departures list showing upcoming buses between Ahmedabad and Rajkot" width="390" height="844" decoding="async" loading="lazy">
      </picture>
      <figcaption><Fragment set:html={t.shot2} /></figcaption>
    </figure>

    <!-- Screen 3: Nearby Radar -->
    <figure class="shot reveal">
      <picture>
        <source srcset="/screens/nearby-dark.webp" media="(prefers-color-scheme: dark)">
        <img class="device" src="/screens/nearby-light.webp" alt="Nearby bus stops screen with distance radar and interactive map" width="390" height="844" decoding="async" loading="lazy">
      </picture>
      <figcaption><Fragment set:html={t.shot3} /></figcaption>
    </figure>
  </div>
</section>

<section id="how" class="band">
  <div class="wrap section">
    <h2><Fragment set:html={t.howH} /></h2>
    <ol class="steps">
      <li class="reveal"><b><Fragment set:html={t.s1H} /></b><span><Fragment set:html={t.s1P} /></span></li>
      <li class="reveal"><b><Fragment set:html={t.s2H} /></b><span><Fragment set:html={t.s2P} /></span></li>
      <li class="reveal"><b><Fragment set:html={t.s3H} /></b><span><Fragment set:html={t.s3P} /></span></li>
    </ol>
    <p class="cta-row"><a class="btn primary lg" href="https://tracker.shivrajsinh.in"><Fragment set:html={t.openApp2} /></a></p>
  </div>
</section>

