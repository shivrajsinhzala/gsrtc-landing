---
import { useTranslations, type Locale } from '../i18n/ui';

interface Props { lang: Locale }

const { lang } = Astro.props;
const t = useTranslations(lang);

// Only the homepage exists in Gujarati, so every guide/route/city link resolves to its English
// URL in both languages. That is deliberate: a /gu/ URL serving English body copy would be
// worse for both the reader and the ranking than an honest English link. See src/i18n/README.md.
const home = lang === 'gu' ? '/gu' : '/';
const href = (slug: string) => `/${slug}`;
---

<main id="main">

<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-head reveal">
      <p class="eyebrow"><Fragment set:html={t.eyebrow} /></p>
      <h1><Fragment set:html={t.h1} /></h1>
    </div>

    <div class="hero-rest reveal">
      <p class="lede"><Fragment set:html={t.lede} /></p>

      <form class="plate" id="plate-form">
        <label class="sr" for="plate"><Fragment set:html={t.plateLabel} /></label>
        <svg class="plate-search-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/></svg>
        <input id="plate" name="plate" type="text" inputmode="latin" autocomplete="off"
               placeholder="GJ-18-ZT-1028" aria-describedby="plate-hint">
        <button class="btn primary" type="submit"><Fragment set:html={t.track} /></button>
      </form>

      <div class="plate-samples">
        <span>Examples:</span>
        <a href="https://tracker.shivrajsinh.in/?plate=GJ-18-ZT-1028">GJ-18-ZT-1028</a>
        <a href="https://tracker.shivrajsinh.in/?plate=GJ-01-CZ-4521">GJ-01-CZ-4521</a>
        <a href="https://tracker.shivrajsinh.in/?from=470&amp;to=462&amp;fromName=Rajkot&amp;toName=Morbi">Rajkot ↔ Morbi</a>
      </div>

      <p class="cta-alt">
        <a class="btn ghost lg" href="https://tracker.shivrajsinh.in"><Fragment set:html={t.openApp} /></a>
        <span><Fragment set:html={t.ctaAltNote} /></span>
      </p>
    </div>

    <div class="hero-art reveal" aria-hidden="true">
      <div class="phone">
        <div class="phone-screen">
          <div class="mini-bar">
            <span class="dot live"></span>
            <b>GJ-18-ZT-1028</b>
            <span class="mini-live-tag">LIVE GPS</span>
          </div>
          <svg class="route" viewBox="0 0 260 300" role="img" aria-label="">
            <path class="road" d="M40 280 C 60 210, 120 200, 130 150 S 190 70, 220 24"/>
            <path class="road-done" d="M40 280 C 60 210, 120 200, 130 150 S 190 70, 220 24"/>
            <circle class="stop" cx="40" cy="280" r="5"/>
            <circle class="stop" cx="130" cy="150" r="5"/>
            <circle class="stop" cx="220" cy="24" r="5"/>
            <g class="bus-marker"><circle r="13"/><text y="4">▮</text></g>
          </svg>
          <div class="mini-stats">
            <div><b>4 min</b><small><Fragment set:html={t.miniNext} /></small></div>
            <div><b>46 km/h</b><small><Fragment set:html={t.miniSpeed} /></small></div>
            <div><b>2.1 km</b><small><Fragment set:html={t.miniAway} /></small></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="strip">
  <div class="wrap strip-grid">
    <div class="strip-card reveal"><b data-count="8554">8,554</b><span><Fragment set:html={t.statBuses} /></span></div>
    <div class="strip-card reveal"><b data-count="19026">19,026</b><span><Fragment set:html={t.statStations} /></span></div>
    <div class="strip-card reveal"><b><Fragment set:html={t.statLive} /></b><span><Fragment set:html={t.statLiveSub} /></span></div>
    <div class="strip-card reveal"><b>2</b><span><Fragment set:html={t.statLang} /></span></div>
  </div>
</section>

<section id="about" class="wrap section narrow">
  <h2><Fragment set:html={t.aboutH} /></h2>
  <p><Fragment set:html={t.aboutP1} /></p>
  <p><Fragment set:html={t.aboutP2} /></p>
</section>

<section id="compare" class="wrap section">
  <h2><Fragment set:html={t.compareH} /></h2>
  <p class="sub"><Fragment set:html={t.compareSub} /></p>
  <div class="cards">
    <article class="card reveal">
      <h3><Fragment set:html={t.c1H} /></h3>
      <p><Fragment set:html={t.c1P} /></p>
    </article>
    <article class="card reveal">
      <h3><Fragment set:html={t.c2H} /></h3>
      <p><Fragment set:html={t.c2P} /></p>
    </article>
    <article class="card reveal">
      <h3><Fragment set:html={t.c3H} /></h3>
      <p><Fragment set:html={t.c3P} /></p>
    </article>
  </div>
</section>

