---
import { useTranslations, type Locale } from '../i18n/ui';
import { CITY } from '../data/pages.data.mjs';

interface Props { lang: Locale }

const { lang } = Astro.props;
const t = useTranslations(lang);

// Only the homepage exists in Gujarati, so every guide/route/city link resolves to its English
// URL in both languages. That is deliberate: a /gu/ URL serving English body copy would be
// worse for both the reader and the ranking than an honest English link. See src/i18n/README.md.
const home = lang === 'gu' ? '/gu' : '/';
const href = (slug: string) => `/${slug}`;

// The link LABEL is localized even where the destination is not — that is a normal pattern
// (a Gujarati reader still benefits from a Gujarati label pointing at an English page) and is
// unrelated to the hreflang/doorway-page concern in src/i18n/README.md, which is about claiming
// a translated *document* exists. pages.data.mjs already carries a Gujarati name for every
// city; this was the one thing on the Gujarati homepage that ignored it and stayed English.
const cityName = (key: keyof typeof CITY) => (lang === 'gu' ? CITY[key].guj : CITY[key].name);
