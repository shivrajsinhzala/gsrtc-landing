        "priceCurrency": "INR"
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "GSRTC Bus Tracker",
        "item": "https://gsrtc.shivrajsinh.in/"
      },
      {
