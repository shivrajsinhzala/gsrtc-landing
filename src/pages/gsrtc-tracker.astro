---
import Base from '../layouts/Base.astro';

/**
 * Ported verbatim from the pre-Astro gsrtc-tracker.html — one of the hand-written pages, each
 * hitting a distinct high-intent search phrase with its own angle rather than being a reworded
 * copy of the others. The body copy below is unchanged; only internal links (now extensionless)
 * and asset paths (now absolute) were rewritten.
 */
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "GSRTC Tracker — Track Any Gujarat ST Bus Live on a Map",
    "description": "Track any Gujarat ST (GSRTC) bus live on a map by its number plate. See where it is now, when it reaches your stop, and full timetables. Free, no account.",
    "url": "https://gsrtc.shivrajsinh.in/gsrtc-tracker",
    "inLanguage": "en-IN",
    "datePublished": "2026-01-15T00:00:00+05:30",
    "dateModified": "2026-09-06T00:00:00+05:30",
    "author": {
      "@type": "Person",
      "name": "Shivrajsinh Zala",
      "url": "https://shivrajsinh.in",
      "jobTitle": "Transit Systems & Web Developer",
      "sameAs": ["https://shivrajsinh.in", "https://github.com/shivrajsinh"]
    },
    "publisher": {
      "@type": "Organization",
      "name": "GSRTC Bus Tracker",
      "url": "https://gsrtc.shivrajsinh.in/",
      "logo": {
        "@type": "ImageObject",
        "url": "https://gsrtc.shivrajsinh.in/icons/icon-512.png"
